# Public Supabase values for optional iCreate accounts.
# Copy to a local .env or export in the shell before `cargo run`.
# Packaged builds can bake them in at compile time with the same names.
# Never put the service_role key or PayFast secrets here — those stay on the Edge Functions.

ICREATE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
ICREATE_SUPABASE_ANON_KEY=
